{
  "compact": true,
  "format": "bento/slides",
  "title": "Why a pendulum keeps time",
  "theme": {
    "background": "#0f1420",
    "color": "#eef2f7",
    "accent": "#ffb86b",
    "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "present": {
    "morphSeconds": 0.8,
    "morphEase": "power2.inOut"
  },
  "slides": [
    {
      "id": "s-title",
      "transition": "fade",
      "background": "#0f1420",
      "notes": "Arrival: the subtitle fades in by itself (an effect \"with previous\" before the first click). Click 1: the gear turns two full turns on a custom curve while the caption fades in with it.",
      "elements": [
        {
          "id": "title",
          "type": "text",
          "x": 96,
          "y": 120,
          "w": 760,
          "h": 160,
          "md": "Why a pendulum keeps time",
          "color": "#eef2f7",
          "fontSize": 64,
          "fontWeight": 800,
          "lineHeight": 1.05,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "sub",
          "type": "text",
          "x": 96,
          "y": 300,
          "w": 640,
          "h": 50,
          "md": "A physics explainer in a few clicks",
          "color": "#9aa7b8",
          "fontSize": 28,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "gear",
          "type": "svg",
          "x": 780,
          "y": 200,
          "w": 400,
          "h": 400,

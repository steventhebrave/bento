        },
        {
          "id": "caption",
          "type": "text",
          "x": 96,
          "y": 560,
          "w": 640,
          "h": 50,
          "md": "Every tick of a clock is one swing.",
          "color": "#ffb86b",
          "fontSize": 28,
          "fontWeight": 600,
          "align": "left",
          "valign": "top"
        }
      ],
      "anim": [
        {
          "id": "t1",
          "el": "sub",
          "type": "fade-in",
          "trigger": "with",
          "delay": 0.4,
          "duration": 0.8
        },
        {
          "id": "t2",
          "el": "gear",
          "type": "spin",
          "trigger": "click",
          "deg": 720,
          "duration": 2.4,
          "ease": [
            0.45,
            0,
            0.15,
            1
          ]
        },
        {
          "id": "t3",
          "el": "caption",
          "type": "fade-in",
          "trigger": "with",
          "delay": 0.6,
          "duration": 0.6,
          "fromDy": 16
        }
      ]
    },
    {
      "id": "s-push",
      "transition": "morph",
      "background": "#0f1420",
      "morphSeconds": 1.1,
      "morphEase": [
        0.7,
        0,
        0.2,
        1
      ],
      "notes": "The gear morphs into the corner on a slow-start curve (its two turns do not unwind). Click 1: F appears and the arrow pushes the block. Click 2: the displacement label. Click 3: the labels and arrow leave together; the block stays where it was pushed.",
      "elements": [
        {
          "id": "heading",
          "type": "text",
          "x": 96,
          "y": 72,
          "w": 900,
          "h": 80,
          "md": "A push sets it moving",
          "color": "#eef2f7",
          "fontSize": 48,
          "fontWeight": 800,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "gear",
          "type": "svg",
          "x": 1084,
          "y": 40,
          "w": 120,
          "h": 120,

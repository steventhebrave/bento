          "id": "floor",
          "type": "shape",
          "shape": "rect",
          "x": 96,
          "y": 520,
          "w": 1088,
          "h": 4,
          "fill": "#3a4558"
        },
        {
          "id": "block",
          "type": "shape",
          "shape": "rect",
          "x": 320,
          "y": 400,
          "w": 120,
          "h": 120,
          "fill": "#ffb86b",
          "radius": 10
        },
        {
          "id": "arrow",
          "type": "shape",
          "shape": "arrow",
          "x": 96,
          "y": 430,
          "w": 200,
          "h": 60,
          "fill": "#6bc4ff"
        },
        {
          "id": "lab-f",
          "type": "text",
          "x": 160,
          "y": 360,
          "w": 80,
          "h": 60,
          "md": "**F**",
          "color": "#6bc4ff",
          "fontSize": 40,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "lab-x",
          "type": "text",
          "x": 420,
          "y": 560,
          "w": 400,
          "h": 50,
          "md": "displacement **x**",
          "color": "#9aa7b8",
          "fontSize": 28,
          "align": "left",
          "valign": "top"
        }
      ],
      "anim": [
        {
          "id": "p1",
          "el": "lab-f",
          "type": "appear",
          "trigger": "click"
        },
        {
          "id": "p2",
          "el": "arrow",
          "type": "move",
          "trigger": "with",
          "dx": 220,
          "dy": 0,
          "duration": 0.7,
          "ease": "power2.in"
        },
        {
          "id": "p3",
          "el": "block",
          "type": "move",
          "trigger": "with",
          "delay": 0.1,
          "dx": 200,
          "dy": 0,
          "duration": 0.9,
          "ease": "power2.out"
        },
        {
          "id": "p4",
          "el": "lab-f",
          "type": "move",
          "trigger": "with",
          "dx": 220,
          "dy": 0,
          "duration": 0.7,
          "ease": "power2.in"
        },
        {
          "id": "p5",
          "el": "lab-x",
          "type": "fade-in",
          "trigger": "click",
          "duration": 0.5
        },
        {
          "id": "p6",
          "el": "lab-f",
          "type": "fade-out",
          "trigger": "click",
          "duration": 0.4
        },
        {
          "id": "p7",
          "el": "arrow",
          "type": "fade-out",
          "trigger": "with",
          "duration": 0.4
        },
        {
          "id": "p8",
          "el": "lab-x",
          "type": "disappear",
          "trigger": "after"
        }
      ]
    },
    {
      "id": "s-swing",
      "transition": "morph",
      "background": "#0f1420",
      "notes": "The block morphs into the bob from where the push left it (not from its model position). Click 1: the restoring-force label. Click 2: the period formula — it depends only on the length.",
      "elements": [
        {
          "id": "heading",
          "type": "text",
          "x": 96,
          "y": 72,
          "w": 900,
          "h": 80,
          "md": "Gravity pulls it back",
          "color": "#eef2f7",
          "fontSize": 48,
          "fontWeight": 800,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "gear",
          "type": "svg",
          "x": 1084,
          "y": 40,
          "w": 120,
          "h": 120,
          "markup": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 400\"><path d=\"M350.0,200.0 L379.6,211.3 L376.4,235.6 L344.9,238.8 L338.6,257.4 L329.9,275.0 L349.9,299.6 L335.0,319.0 L306.1,306.1 L291.3,319.0 L275.0,329.9 L280.0,361.2 L257.4,370.6 L238.8,344.9 L219.6,348.7 L200.0,350.0 L188.7,379.6 L164.4,376.4 L161.2,344.9 L142.6,338.6 L125.0,329.9 L100.4,349.9 L81.0,335.0 L93.9,306.1 L81.0,291.3 L70.1,275.0 L38.8,280.0 L29.4,257.4 L55.1,238.8 L51.3,219.6 L50.0,200.0 L20.4,188.7 L23.6,164.4 L55.1,161.2 L61.4,142.6 L70.1,125.0 L50.1,100.4 L65.0,81.0 L93.9,93.9 L108.7,81.0 L125.0,70.1 L120.0,38.8 L142.6,29.4 L161.2,55.1 L180.4,51.3 L200.0,50.0 L211.3,20.4 L235.6,23.6 L238.8,55.1 L257.4,61.4 L275.0,70.1 L299.6,50.1 L319.0,65.0 L306.1,93.9 L319.0,108.7 L329.9,125.0 L361.2,120.0 L370.6,142.6 L344.9,161.2 L348.7,180.4 Z M250,200 A50,50 0 1,0 150,200 A50,50 0 1,0 250,200 Z\" fill=\"#ffb86b\" fill-rule=\"evenodd\"/><circle cx=\"200\" cy=\"200\" r=\"18\" fill=\"#0f1420\"/></svg>"
        },
        {
          "id": "rod",
          "type": "shape",
          "shape": "rect",
          "x": 638,
          "y": 180,
          "w": 4,
          "h": 300,
          "fill": "#9aa7b8"
        },
        {
          "id": "block",
          "type": "shape",
          "shape": "ellipse",
          "x": 590,
          "y": 460,
          "w": 100,
          "h": 100,
          "fill": "#ffb86b"
        },
        {
          "id": "lab-g",
          "type": "text",
          "x": 760,
          "y": 440,
          "w": 420,
          "h": 50,
          "md": "restoring force ∝ sin θ",
          "color": "#6bc4ff",
          "fontSize": 28,
          "align": "left",
          "valign": "top"
        },
        {
          "id": "lab-t",
